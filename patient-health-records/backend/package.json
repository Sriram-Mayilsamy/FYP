{
  "name": "patient-health-records-backend",
  "version": "1.0.0",
  "description": "Express backend for patient health record management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "node db/schema.js",
    "db:seed": "node db/seed.js",
    "blockchain:compile": "hardhat compile",
    "blockchain:ganache": "ganache --server.port 8545 --wallet.deterministic",
    "blockchain:deploy": "hardhat run blockchain/deploy.js --network ganache",
    "blockchain:verify": "node scripts/verifyRecord.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.13.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.17",
    "nodemon": "^3.0.1"
  }
}
